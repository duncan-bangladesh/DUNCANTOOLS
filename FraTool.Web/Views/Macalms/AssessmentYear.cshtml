
@{
    ViewData["Title"] = "Assessment Year";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row rowtop">
    <div class="col-md-12">
        <div class="card card-info card-outline collapsed-card" id="entry-ui">
            <div class="card-header">
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-plus"></i>&nbsp; &nbsp; Add Assessment Year
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="col-md-6">
                    <form class="form-horizontal">
                        <input id="RecordId" value="0" hidden type="text" />
                        <div class="form-group row">
                            <label class="control-label text-md-right text-sm-left col-md-4">Year</label>
                            <div class="col-md-8">
                                <input id="YearName" name="YearName" autocomplete="off" class="form-control" placeholder="assessment year - ex: 2020" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="offset-md-4 col-md-8">
                                <input type="button" id="btnSave" value="Save" class="btn btn-success" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row rowtop">
    <div class="col-md-12">
        <div class="card card-success card-outline">
            <div class="card-header">
                <h3 class="card-title">Assessment Year</h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover" id="rTable">
                    <thead>
                        <tr class="bg-success">
                            <th>Year</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/macalms/assessment_year.js"></script>
    <script></script>
}


